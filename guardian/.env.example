# Guardian configuration. Copy to guardian/.env  (cp .env.example .env)
# DEV VALUES ONLY — generate your own secrets:  python -c "import secrets;print(secrets.token_hex(32))"

# ---- Partner addresses (never hard-coded in code) ----
# Standalone: point to the mocks/dev broker. Integrated: point to Twin's real broker / services.
TWIN_BASE_URL=https://twin:8443
BRAIN_BASE_URL=https://brain:8443

# ---- MQTT (Twin event stream in, Guardian verdicts out) — mTLS ----
MQTT_ENABLED=true
MQTT_HOST=guardian-mqtt
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_FILE=/certs/ca.pem
MQTT_CERT_FILE=/certs/guardian-client.pem
MQTT_KEY_FILE=/certs/guardian-client.key
MQTT_CLIENT_ID=guardian
TOPIC_TWIN_EVENTS=twin/events
TOPIC_VERDICTS=guardian/verdicts
TOPIC_CONTROL=guardian/control
# TOPIC_TIMELINE: unset => triplet/timeline/guardian (native) or guardian/timeline (Brain profile)
# TOPIC_TIMELINE=triplet/timeline/guardian

# ---- Storage (PostgreSQL + TimescaleDB). Empty => in-memory (tests only) ----
DATABASE_URL=postgresql://guardian:guardian-dev-pw@guardian-db:5432/guardian
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian-dev-pw
POSTGRES_DB=guardian

# ---- Auth ----
# One HS256 secret per caller role; the role is derived from the key that verifies the token.
GUARDIAN_JWT_KEYS=brain=dev-brain-secret-change-me-0123456789abcdef,twin=dev-twin-secret-change-me-0123456789abcdef,ui=dev-ui-secret-change-me-0123456789abcdef,admin=dev-admin-secret-change-me-0123456789abcdef
JWT_AUDIENCE=guardian
JWT_MAX_TTL_S=120
# Shared with Twin: HMAC-SHA256 key Twin uses to sign every event
TWIN_EVENT_HMAC_KEY=dev-twin-hmac-change-me-0123456789abcdef
# Guardian's Ed25519 verdict-signing key (generated on first start if missing)
VERDICT_SIGNING_KEY_FILE=/keys/verdict_ed25519.pem

# ---- Exposed API (JSON-RPC over HTTPS/WSS) — mTLS ----
API_HOST=0.0.0.0
API_PORT=8443
REQUIRE_MTLS=true
TLS_CA_FILE=/certs/ca.pem
TLS_CERT_FILE=/certs/guardian.pem
TLS_KEY_FILE=/certs/guardian.key
# client-cert CN -> JWT issuer it is allowed to use
ALLOWED_CLIENT_CNS=brain.triplet=brain,twin.triplet=twin,ui.triplet=ui,admin.triplet=admin

# ---- Detection / containment tuning ----
STUCK_WINDOW_S=300
QUARANTINE_THRESHOLD=3
QUARANTINE_COUNT_UNAUTHENTICATED=false
REPLAY_CACHE_SIZE=100000
REPLAY_WINDOW_S=3600
ROLLBACK_WINDOW_S=600

# ---- Scenario runner (live mode) ----
GUARDIAN_RPC_URL=https://guardian:8443
SCENARIO_CERT_DIR=/certs

# =====================================================================================
# ---- Brain protocol profile (city-brain integration kit). INTERFACE.md section 8 ----
# Off by default: the native protocol above keeps working unchanged.
# Secrets (ca.crt, password, *.key) are handed over privately: keep them OUTSIDE the repo
# (e.g. ~/triplet-secrets/) and point to them here. Never commit them.
# =====================================================================================
BRAIN_PROTOCOL_ENABLED=false
# Broker of the Brain team: TLS only, account "guardian" + password file, NO client certificate
#   MQTT_HOST=<brain LAN IP>   MQTT_PORT=8883   MQTT_TLS=true
#   MQTT_CA_FILE=/secrets/ca.crt   MQTT_CERT_FILE=   MQTT_KEY_FILE=
MQTT_USERNAME=
MQTT_PASSWORD_FILE=
# unique per client; empty => <MQTT_CLIENT_ID>-pub-<random> / <MQTT_CLIENT_ID>-sub-<random>
MQTT_CLIENT_ID_PUB=
MQTT_CLIENT_ID_SUB=
# prefix of every id we send (gd-<run id>-000001); empty => random at each start
GUARDIAN_RUN_ID=
# HMAC keys: the TEXT of the .key file, whitespace stripped, used as UTF-8 (never hex-decoded)
TWIN_GUARDIAN_KEY_FILE=
GUARDIAN_BRAIN_KEY_FILE=
HMAC_TAG=guardian
# Topics ({placeholders} are parsed from / filled into the topic)
TOPIC_TWIN_META=twin/meta
TOPIC_READING=city/{zone_id}/sensor/{type}/{sensor_id}
TOPIC_ACTUATOR=twin/actuator/{actuator_id}
TOPIC_UNIT=twin/unit/{unit_id}
TOPIC_BRAIN_CMD=brain/cmd/{target_id}
TOPIC_BRAIN_ALERT=brain/alert
TOPIC_BRAIN_ERROR=brain/error
TOPIC_GUARDIAN_CONTROL=guardian/control
TOPIC_OUT_VERDICT=guardian/verdict/{sensor_id}
TOPIC_OUT_QUARANTINE=guardian/quarantine/{device_id}
TOPIC_OUT_STATUS=guardian/status
# With BRAIN_PROTOCOL_ENABLED=true and TOPIC_TIMELINE unset, the timeline defaults to
# guardian/timeline (triplet/timeline/guardian is outside the guardian/# ACL)
# Thresholds (calibration: INTERFACE.md section 8)
SENSOR_LIMITS_FILE=config/sensor_limits.brain.json
CLOCK_SKEW_S=10
STEP_WINDOW_S=30
ANOMALY_Z_OK=2.0
ANOMALY_SPAN=8.0
# 0.4 => the anomaly rule alone can make a reading suspicious, never rejected (Brain profile)
ANOMALY_MIN_SCORE=0.4
# identical consecutive readings => suspicious / frozen (0 = off; native profile keeps STUCK_WINDOW_S)
FROZEN_COUNT=8
# re-send the current verdicts after this many seconds without any verdict (Brain: offline after 30 s; 0 = off)
VERDICT_REFRESH_S=20
# QUARANTINE_THRESHOLD (above) = consecutive rejected readings before quarantine; 3 for T5
ACK_TIMEOUT_S=4
ACK_GRACE_S=4
ACK_QUARANTINE_THRESHOLD=2
ACK_STARTUP_GRACE_S=10
ALERT_COUNTS_AS_INCONSISTENCY=true
BRAIN_PUBLISH_REPLAY_VERDICTS=false
SEQ_RESET_ON_NEW_META=true
