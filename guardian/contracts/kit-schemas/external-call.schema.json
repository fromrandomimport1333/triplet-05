{
  "description": "city/{zone}/call (TW-9, TW-10).",
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "string"
    },
    "source": {
      "enum": [
        "twin",
        "guardian",
        "brain"
      ],
      "title": "Source",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "seq": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seq"
    },
    "call_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Call Id",
      "type": "string"
    },
    "zone_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Zone Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "fire",
        "accident",
        "flood",
        "medical",
        "other"
      ],
      "title": "Category",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 280,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    }
  },
  "required": [
    "id",
    "timestamp",
    "source",
    "call_id",
    "zone_id",
    "category"
  ],
  "title": "CallBody",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
