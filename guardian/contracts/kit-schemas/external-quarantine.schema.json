{
  "description": "guardian/quarantine/{device_id} (GD-7).",
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "string"
    },
    "source": {
      "enum": [
        "twin",
        "guardian",
        "brain"
      ],
      "title": "Source",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "seq": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seq"
    },
    "device_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Device Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "quarantined",
        "released"
      ],
      "title": "State",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "id",
    "timestamp",
    "source",
    "device_id",
    "state",
    "reason"
  ],
  "title": "QuarantineBody",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
