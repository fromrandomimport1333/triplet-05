# Copy to .env (never committed) and set real values. Every variable is optional: without it, the YAML file is used.
# Read by the Twin (twin/city.yaml), our stand-ins (twin/mocks/mocks.yaml), the scenarios, contract_check.py,
# start.ps1 and docker-compose.yml (which takes only the keys from here; host names are fixed inside the stack). Partner layers should read the same names.

# --- broker ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- shared signing key of the triplet (HMAC-SHA256 on every message) ---
TSYP_HMAC_KEY=change-me-too

# --- where each layer is (swap a stand-in for the real layer by changing only these) ---
TWIN_URL=http://127.0.0.1:8000
GUARDIAN_URL=http://127.0.0.1:8001
BRAIN_URL=http://127.0.0.1:8003

# --- the Twin's keys, one per layer (least privilege) ---
TWIN_API_KEY=change-me              # Brain key: command actuators
TWIN_GUARDIAN_KEY=guardian-twin-key # Guardian key: quarantine / release only
TWIN_TEST_KEY=test-key              # test scripts: faults, conditions, reset, /truth, /events

# --- the Guardian's key (sent by the Brain and the scenarios to POST /verify) ---
GUARDIAN_API_KEY=guardian-key
BRAIN_GUARDIAN_KEY=guardian-key

# --- ports of our stand-ins ---
GUARDIAN_PORT=8001
BRAIN_PORT=8003
